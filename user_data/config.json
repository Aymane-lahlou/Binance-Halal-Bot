{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "halal-binance-spot",
  "initial_state": "stopped",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "cancel_open_orders_on_exit": true,
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "timeframe": "15m",
  "ignore_buying_expired_candle_after": 300,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "XRP/USDT",
      "ADA/USDT",
      "LINK/USDT",
      "AVAX/USDT",
      "DOT/USDT",
      "LTC/USDT"
    ],
    "pair_blacklist": [
      "BNB/USDT",

      "DOGE/USDT",
      "SHIB/USDT",
      "PEPE/USDT",
      "FLOKI/USDT",
      "WIF/USDT",

      "USDE/USDT",
      "ENA/USDT",

      "AAVE/USDT",
      "COMP/USDT",
      "MKR/USDT",
      "SNX/USDT",
      "DYDX/USDT",
      "GMX/USDT",
      "CRV/USDT",
      "LDO/USDT",
      "RPL/USDT",

      "SKY/USDT",
      "CREAM/USDT",
      "VENUS/USDT",
      "XVS/USDT",
      "ALPACA/USDT",
      "JST/USDT",
      "QI/USDT",
      "BIFI/USDT",
      "RDNT/USDT",
      "EUL/USDT",
      "GHO/USDT",
      "MORPHO/USDT",
      "SPELL/USDT",
      "MIM/USDT",
      "ALPHA/USDT",
      "LQTY/USDT",
      "STG/USDT",
      "CVX/USDT",
      "YFI/USDT",
      "FXS/USDT",

      "SUSDE/USDT",
      "USDD/USDT",
      "USDX/USDT",

      "GNS/USDT",
      "LEVER/USDT",

      "JTO/USDT",
      "SD/USDT",
      "PENDLE/USDT",

      "FUN/USDT",
      "WINK/USDT",
      "WIN/USDT",
      "EDG/USDT",

      ".*UP/USDT",
      ".*DOWN/USDT",
      ".*BULL/USDT",
      ".*BEAR/USDT",
      ".*3L/USDT",
      ".*3S/USDT",
      ".*5L/USDT",
      ".*5S/USDT",
      ".*PERP.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "unfilledtimeout": {
    "entry": 5,
    "exit": 10,
    "exit_timeout_count": 2,
    "unit": "minutes"
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET",
    "ws_token": "CHANGE_THIS_WS_TOKEN",
    "CORS_origins": [],
    "username": "freqtrade",
    "password": "CHANGE_THIS_PASSWORD"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 5
  }
}